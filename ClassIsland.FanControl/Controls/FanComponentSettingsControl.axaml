<controls:ComponentBase x:Class="ClassIsland.FanControl.Controls.FanComponentSettingsControl"
                        x:TypeArguments="models:FanComponentSettings"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:models="clr-namespace:ClassIsland.FanControl.Models"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        mc:Ignorable="d"
                        d:DesignHeight="300" d:DesignWidth="700">
    <ScrollViewer>
        <StackPanel x:Name="RootPanel"
                    Classes="component-settings-container animated-intro"
                    Margin="0">
            <fa:SettingsExpander IconSource="{ci:LucideIconSource &#xE37D;}"
                                 Header="显示的风扇"
                                 Description="选择这个组件要显示哪一路风扇的实时转速。">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="240"
                              ItemsSource="{Binding FanChoices}"
                              SelectedItem="{Binding SelectedFanChoice, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Name}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
