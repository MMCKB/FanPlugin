<controls:ComponentBase x:Class="ClassIsland.FanControl.Controls.FanComponent"
                        x:TypeArguments="models:FanComponentSettings"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:ClassIsland.FanControl.Controls"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:models="clr-namespace:ClassIsland.FanControl.Models"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        mc:Ignorable="d"
                        d:DesignHeight="80" d:DesignWidth="300">
    <!--
        注意：ComponentPresenter 会把本组件的 DataContext 覆盖成主窗口的 DataContext，
        所以这里必须像官方组件一样，通过 RelativeSource 指回组件自身，再取 ViewModel。
    -->
    <StackPanel Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                DataContext="{Binding ViewModel, RelativeSource={RelativeSource FindAncestor, AncestorType=local:FanComponent}}">
        <ci:LucideIcon Glyph="&#xE37D;" VerticalAlignment="Center" />
        <TextBlock Text="{Binding DisplayText}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</controls:ComponentBase>
